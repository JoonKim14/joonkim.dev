---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'joonkim.dev', description = 'A retro pixel-art RPG personal website.' } = Astro.props;

const isHome = Astro.url.pathname === '/';
const isCredits = Astro.url.pathname === '/credits' || Astro.url.pathname === '/credits/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/pixel-avatar.png?v=1" />
    <link rel="shortcut icon" type="image/png" href="/pixel-avatar.png?v=1" />
    <link rel="apple-touch-icon" href="/pixel-avatar.png?v=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    {!isHome && (
      <nav class="fixed top-4 left-4 z-50">
        <a
          href={isCredits ? '/#menu' : '/#town'}
          class="inline-flex items-center rounded border-2 border-panel-light/80 bg-panel/80 px-3 py-2 font-pixel text-[9px] uppercase tracking-wide text-gold hover:text-parchment transition-colors"
        >
          ← Back to {isCredits ? 'Menu' : 'Town'}
        </a>
      </nav>
    )}
    <slot />

    <audio id="bg-music" loop preload="auto" transition:persist>
      <source src="/audio/life-is-full-of-joy.mp3" type="audio/mpeg" />
    </audio>

    <button
      id="music-toggle"
      aria-label="Toggle music"
      transition:persist
      class="fixed right-4 top-4 z-50 flex h-9 w-9 items-center justify-center rounded border-2 border-panel-light/80 bg-panel/80 text-base text-gold hover:text-parchment transition-colors"
    >
      🔊
    </button>

    <script is:inline>
      (function () {
        if (window.__musicInit) return;
        window.__musicInit = true;

        var audio = document.getElementById('bg-music');
        var btn = document.getElementById('music-toggle');
        var muted = localStorage.getItem('musicMuted') === 'true';

        audio.volume = 0.13;

        function updateBtn() {
          if (btn) btn.textContent = muted ? '🔇' : '🔊';
        }
        updateBtn();

        function tryPlay() {
          if (!muted) audio.play().catch(function () {});
        }

        function onFirstInteraction() {
          document.removeEventListener('click', onFirstInteraction);
          document.removeEventListener('keydown', onFirstInteraction);
          tryPlay();
        }
        document.addEventListener('click', onFirstInteraction);
        document.addEventListener('keydown', onFirstInteraction);

        if (btn) {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            muted = !muted;
            localStorage.setItem('musicMuted', String(muted));
            updateBtn();
            if (muted) {
              audio.pause();
            } else {
              audio.play().catch(function () {});
            }
          });
        }
      })();
    </script>
  </body>
</html>
