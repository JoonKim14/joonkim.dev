---
import Layout from '../layouts/Layout.astro';
import RPGPanel from '../components/RPGPanel.astro';

const traits = [
  { name: 'RELATOR', description: 'Builds few but deeply loyal connections. Authenticity over volume.' },
  { name: 'ARRANGER', description: 'Finds the optimal configuration when juggling complex, moving parts.' },
  { name: 'LEARNER', description: 'Energized by the process of acquiring knowledge, not just the destination.' },
  { name: 'BELIEF', description: 'Decisions anchored in core values, not convenience.' },
  { name: 'INTELLECTION', description: 'Drawn to deep thinking, reflection, and solitary reasoning.' },
];

const rarityGroups = [
  {
    rarity: 'LEGENDARY',
    rarityClass: 'text-gold',
    items: [
      { name: 'Problem Detection', note: 'Finds edge cases early before they become incidents.' },
      { name: 'Systems Thinking', note: 'Connects product, data, and architecture constraints.' },
    ],
  },
  {
    rarity: 'EPIC',
    rarityClass: 'text-purple',
    items: [
      { name: 'Python', note: 'Automation, data tooling, and service glue.' },
      { name: 'TypeScript', note: 'Typed frontend/backend workflows and API contracts.' },
      { name: 'C# / .NET', note: 'Production backend services at Geotab.' },
      { name: 'SQL', note: 'Query tuning and schema-aware data modeling.' },
    ],
  },
  {
    rarity: 'RARE',
    rarityClass: 'text-cyan',
    items: [
      { name: 'React', note: 'Fast interfaces with pragmatic DX.' },
      { name: 'GCP', note: 'Cloud infra, Cloud Tasks, and service integrations.' },
      { name: 'Kubernetes / Docker', note: 'Container orchestration and pod-level debugging.' },
      { name: 'Node.js', note: 'API and service layer in JS/TS stacks.' },
    ],
  },
  {
    rarity: 'UNCOMMON',
    rarityClass: 'text-bar-hp',
    items: [
      { name: 'Terraform', note: 'Infrastructure as code for reproducible cloud environments.' },
      { name: 'C / C++', note: 'Systems-level work and performance-critical code.' },
      { name: 'R', note: 'Statistical analysis and data modeling.' },
    ],
  },
  {
    rarity: 'COMMON',
    rarityClass: 'text-parchment/80',
    items: [
      { name: 'Git', note: 'Clean commit hygiene, debugging, and review flow.' },
      { name: 'Linux', note: 'Comfortable with day-to-day terminal-first workflows.' },
    ],
  },
];
---

<Layout title="Shop | Skills & Stack">
  <main class="min-h-screen bg-[radial-gradient(circle_at_top,_#23335a_0%,_#1a1a2e_52%,_#0f101c_100%)] px-4 pb-16 pt-24">
    <section class="mx-auto max-w-5xl grid gap-6">
      <RPGPanel title="Character Traits">
        <p class="mb-4 text-lg text-parchment/60">Gallup CliftonStrengths — Top 5</p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {traits.map((trait) => (
            <div class="rounded border-2 border-gold/40 bg-panel-dark/55 px-3 py-3">
              <p class="font-pixel text-[10px] uppercase tracking-wide text-gold">{trait.name}</p>
              <p class="mt-2 text-lg leading-relaxed text-parchment/80">{trait.description}</p>
            </div>
          ))}
        </div>
      </RPGPanel>

      <RPGPanel title="Shop | Inventory">
        <div class="grid gap-4">
          {rarityGroups.map((group) => (
            <section class="rounded border-2 border-panel-light/70 bg-panel-dark/45 p-4">
              <h3 class:list={['font-pixel text-[10px] uppercase tracking-wide', group.rarityClass]}>
                [{group.rarity}]
              </h3>
              <div class="mt-3 grid gap-2">
                {group.items.map((item) => (
                  <div
                    class="rounded border border-panel-light/70 bg-panel-dark/70 px-3 py-2"
                    title={item.note}
                  >
                    <p class="text-xl text-parchment">{item.name}</p>
                    <p class="text-lg text-parchment/65">{item.note}</p>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </RPGPanel>
    </section>
  </main>
</Layout>
