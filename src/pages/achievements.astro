---
import Layout from '../layouts/Layout.astro';
import RPGPanel from '../components/RPGPanel.astro';

const achievements = [
  { icon: '🎓', title: 'SCHOLAR OF WATERLOO', description: 'Graduated University of Waterloo — Statistics & Computational Math, Computing minor. June 2025.' },
  { icon: '💼', title: 'CLASS CHANGE', description: 'Landed first full-time software developer role. June 2025.' },
  { icon: '🏃', title: 'ROAD RUNNER', description: 'First race ever. Completed Toronto Half Marathon in 1:55:19. May 3, 2026.' },
  { icon: '🎤', title: 'BARD', description: 'Unlocked the Bard class. Takes the mic at karaoke without hesitation.' },
];
---

<Layout title="Hall of Fame | Achievements">
  <main class="min-h-screen bg-[radial-gradient(circle_at_top,_#3f2a63_0%,_#1d1b38_50%,_#0f0d1e_100%)] px-4 pb-16 pt-24">
    <section class="mx-auto max-w-5xl">
      <RPGPanel title="Hall Of Fame">
        <div class="grid gap-4 sm:grid-cols-2">
          {achievements.map((achievement) => (
            <article class="rounded border-2 border-panel-light/70 bg-panel-dark/45 p-4">
              <p class="text-3xl">{achievement.icon}</p>
              <h3 class="mt-2 font-pixel text-[10px] uppercase tracking-wide text-gold">
                {achievement.title}
              </h3>
              <p class="mt-2 text-xl leading-relaxed text-parchment/85">{achievement.description}</p>
            </article>
          ))}
        </div>
      </RPGPanel>
    </section>
  </main>
</Layout>
